# Build artifacts
build/*.blob
build/bundle.js
build/hermitstash-sync-*
build/gpg-public-key.asc
*.tgz
dist/

# npm
.npmignore
node_modules/

# State (user data, never committed)
*.db
*.pid
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tests — secrets + per-run fixtures stay out of version control even
# though the test source itself ships.
tests/.env
tests/autoupdate-signing.key
tests/certs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Scratch — local-only stress/simulation scripts, throwaway analysis.
.scratch/

# Coverage output: raw V8 JSON (one file per process) and the rendered report.
# Regenerate with `node scripts/coverage.js`.
.coverage/
